// Schema SQLite para versiÃƒÂ³n Desktop VENTECH ERP
// SQLite NO soporta: enums, Json nativos Ã¢â‚¬â€ se usan String en su lugar
// El servidor sigue usando schema.prisma con PostgreSQL (intacto)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  rif       String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  products      Product[]
  categories    Category[]
  productTypes  ProductType[]
  customers     Customer[]
  orders        Order[]
  expenses      Expense[]
  exchangeRates ExchangeRate[]
  auditLogs     AuditLog[]
  sales         Sale[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  password  String
  role      String   @default("CASHIER")
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  orders    Order[]
  auditLogs AuditLog[]
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   String?
  newData   String?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
}

model ExchangeRate {
  id        String   @id @default(uuid())
  tenantId  String
  currency  String
  rate      Decimal
  source    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
}

model Category {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  icon       String?
  attributes String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductType {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  code        String   @default("")
  name        String
  brand       String?
  model       String?
  category    String?
  type        String?
  unit        String   @default("Unidad")
  location    String?
  description String?
  attributes  String?
  priceUSD    Decimal
  costUSD     Decimal?
  stock       Decimal  @default(0)
  minStock    Decimal  @default(5)
  status      String   @default("ACTIVO")
  isExempt    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  variants  Variant[]
  saleItems SaleItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Variant {
  id        String  @id @default(uuid())
  productId String
  sku       String?
  barcode   String?
  name      String
  stock     Decimal @default(0)
  priceDiff Decimal @default(0)

  product    Product        @relation(fields: [productId], references: [id])
  serials    SerialNumber[]
  orderItems OrderItem[]

  @@index([productId])
}

model SerialNumber {
  id        String @id @default(uuid())
  variantId String
  serial    String
  status    String @default("AVAILABLE")

  variant Variant @relation(fields: [variantId], references: [id])

  @@unique([variantId, serial])
}

model Customer {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  documentId  String?
  email       String?
  phone       String?
  creditLimit Decimal @default(0)
  balance     Decimal @default(0)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@index([tenantId])
}

model Order {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  customerId   String?
  fiscalNumber String?
  status       String   @default("COMPLETED")
  totalBase    Decimal
  totalTax     Decimal  @default(0)
  totalIGTF    Decimal  @default(0)
  totalLocal   Decimal
  exchangeRate Decimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([tenantId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  variantId String
  quantity  Int
  unitPrice Decimal
  taxRate   Decimal @default(16)
  subtotal  Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  orderId   String
  method    String
  currency  String
  amount    Decimal
  applyIGTF Boolean  @default(false)
  reference String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  description String
  amount      Decimal
  currency    String
  date        DateTime @default(now())
  receiptUrl  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Sale {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceNumber   String
  totalUSD        Decimal
  totalVES        Decimal
  exchangeRate    Decimal
  subtotalUSD     Decimal
  taxUSD          Decimal
  igtfUSD         Decimal
  paymentMethod   String
  paymentCurrency String
  status          String   @default("COMPLETED")
  notes           String?
  createdAt       DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  items  SaleItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String?
  code      String?
  name      String
  unit      String  @default("Unidad")
  quantity  Decimal
  priceUSD  Decimal
  subtotal  Decimal

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}
