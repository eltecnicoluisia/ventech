{
  "name": "erp-platform",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "bcrypt@6.0.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
